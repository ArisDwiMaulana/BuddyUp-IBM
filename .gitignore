# ==============================================================================
# BuddyUp — .gitignore
# ==============================================================================

# PocketBase local database & runtime data
# (Database SQLite dibuat dan dimigrasi secara otomatis saat pertama kali boot)
data/
pb_data/
*.db
*.db-wal
*.db-shm
.notify

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Operating System generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Code Editor configurations
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Python artifacts (dari script CLI)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
.venv/

# Node / npm logs & artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Docker local overrides
docker-compose.override.yml
